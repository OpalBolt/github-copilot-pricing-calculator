<script>
  // ── Pricing data (fetched {{ fetchDate }}) ──────────────────────────
  // Each model: { id, owned_by, input, cached, output, capabilities, quant,
  //   providers: [...] } — all token rates are € per 1M. `capabilities` is the
  //   derived reasoning/tools/vision/audio flags; `quant` is the cheapest
  //   provider's quantization (badge only when fp4/int4). `providers` is the
  //   drill-down (per-provider price, quant, context, features, audio/speech
  //   cost where present).
  // PROVIDERS is the fetch-derived sovereignty/ZDR table (slice 04); the client
  // only reads it for badges/filters, never recomputes it.
  // ponytail: cached = cache_read_cost where the provider publishes one, else the
  // input rate (fallback baked in generate_html.py). Same / 1_000_000 division as
  // the GitHub tool; Cortecs rates are already €/1M, no further conversion.
  const ALL_MODELS = {{ models_json }};
  const PROVIDERS  = {{ providers_json }};


  const PROFILES = {
    superuser: { name: 'Superuser/Developer', input: 0.49, cached: 98.62, output: 0.89 },
    regular:   { name: 'Regular User', input: 5.45, cached: 86.36, output: 8.18 },
  };

  // ── State ─────────────────────────────────────────────────────────
  // Filter chips are toggles that combine with AND; sort/search/toggles mirror
  // the GitHub tool (templates/app.js.j2). Default sort is cheapest est. cost
  // first — the relative-cost bar is proportional to it, so this ranks by value.
  const state = {
    sortCol: 'cost',
    sortDir: 'asc',
    search: '',
    filters: { sovereign: false, zdr: false, reasoning: false, tools: false, vision: false, audio: false },
    showInput: true,
    showCached: true,
    showOutput: true,
    compareIds: new Set(),
    activeProfile: null,
  };


  // ── Profile presets (mirror app.js.j2) ────────────────────────────
  function setProfile(profileKey) {
    const profile = PROFILES[profileKey];
    if (!profile) return;
    state.activeProfile = profileKey;
    document.getElementById('input-pct').value = profile.input;
    document.getElementById('cached-pct').value = profile.cached;
    document.getElementById('output-pct').value = profile.output;
    document.querySelectorAll('.profile-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.profile === profileKey);
    });
    recompute();
  }

  // ── Helpers ─────────────────────────────────────────────────────────
  const fmt      = n => n.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
  const fmtMoney = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtRuns  = n => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
  const rate     = v => v > 0 ? `€${fmt(v)}` : 'Free';

  // Reads the controls panel. Mirrors app.js.j2 getConfig(): the three percentages
  // are normalized to 100 so an off-sum mix still computes a sane cost.
  function getConfig() {
    const total  = parseFloat(document.getElementById('total-tokens').value) || 1_000_000;
    let ip = parseFloat(document.getElementById('input-pct').value)  || 0;
    let cp = parseFloat(document.getElementById('cached-pct').value) || 0;
    let op = parseFloat(document.getElementById('output-pct').value) || 0;
    const budget = Math.max(0, parseFloat(document.getElementById('budget-amount').value) || 0);
    const sum = ip + cp + op;

    const warning = document.getElementById('pct-warning');
    if (warning) warning.style.display = Math.abs(sum - 100) > 0.1 ? 'block' : 'none';

    if (sum > 0) { ip = ip / sum * 100; cp = cp / sum * 100; op = op / sum * 100; }
    return {
      total,
      inputTokens:  total * ip / 100,
      cachedTokens: total * cp / 100,
      outputTokens: total * op / 100,
      ip, cp, op, budget,
    };
  }

  // Per-run cost in euros. Same shape as the GitHub tool's estimateCost().
  function estimateCost(m, cfg) {
    return (cfg.inputTokens  / 1_000_000) * m.input
         + (cfg.cachedTokens / 1_000_000) * m.cached
         + (cfg.outputTokens / 1_000_000) * (m.output || 0);
  }

  // EU-sovereign / ZDR badges from the baked provider table, not the client.
  function providerBadges(name) {
    const p = PROVIDERS[name];
    if (!p) return '';
    return (p.eu_native ? '<span class="badge-eu" title="EU-sovereign (eu_native)">🇪🇺</span>' : '')
         + (p.zdr ? '<span class="badge-zdr" title="Zero data retention">🔒</span>' : '');
  }

  // Capability badges for the model row (slice 05). Reasoning/Tools/Vision/Audio
  // only when the model supports them; source baked in generate_html.py.
  function capabilityBadges(m) {
    const c = m.capabilities || {};
    const chips = [];
    if (c.reasoning) chips.push('<span class="cap" title="Reasoning">reasoning</span>');
    if (c.tools)     chips.push('<span class="cap" title="Tool use">tools</span>');
    if (c.vision)    chips.push('<span class="cap" title="Image input">vision</span>');
    if (c.audio)     chips.push('<span class="cap" title="Audio input">audio</span>');
    return chips.join('');
  }

  // Muted quant chip — only the heavy compressions that explain a low headline
  // price (plan.md "Edge cases"). Full-quality quants (fp16/bf16/fp8) stay quiet;
  // the drill-down still shows every provider's quant.
  function quantChip(m) {
    const q = m.quant;
    if (q === 'fp4' || q === 'int4') {
      return `<span class="quant-chip" title="Cheapest provider uses ${q} — heavy quantization explains the low price.">${q}</span>`;
    }
    return '';
  }

  // Does the model survive the active filter chips + free-text search?
  function passesFilters(m) {
    if (state.search) {
      const q = state.search.toLowerCase();
      if (!m.id.toLowerCase().includes(q) && !(m.owned_by || '').toLowerCase().includes(q)) return false;
    }
    const f = state.filters;
    const c = m.capabilities || {};
    if (f.reasoning && !c.reasoning) return false;
    if (f.tools && !c.tools) return false;
    if (f.vision && !c.vision) return false;
    if (f.audio && !c.audio) return false;
    if (f.sovereign || f.zdr) {
      const attrs = (m.providers || []).map(p => PROVIDERS[p.name]).filter(Boolean);
      if (f.sovereign && !attrs.some(a => a.eu_native)) return false;
      if (f.zdr && !attrs.some(a => a.zdr)) return false;
    }
    return true;
  }

  // Mirror of app.js.j2's comparator: numeric columns by value, text by
  // localeCompare, nulls sort last. Direction flips on repeat clicks (sort header).
  function sortRows(rows) {
    const col = state.sortCol, dir = state.sortDir === 'asc' ? 1 : -1;
    rows.sort((a, b) => {
      const av = a[col], bv = b[col];
      if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return String(av ?? '').localeCompare(String(bv ?? '')) * dir;
    });
    return rows;
  }

  function barHtml(cost, maxCost) {
    return cost > 0
      ? `<div class="credit-bar-wrap"><div class="credit-bar-bg">`
        + `<div class="credit-bar-fill" style="width:${Math.round(cost / maxCost * 100)}%"></div>`
        + `</div></div>`
      : `<span class="dim">free</span>`;
  }

  function summaryChips(cfg) {
    document.getElementById('summary-chips').innerHTML = `
      <span class="chip">Total tokens: <strong>${cfg.total.toLocaleString()}</strong></span>
      <span class="chip">Input: <strong>${Math.round(cfg.ip)}%</strong></span>
      <span class="chip">Cached: <strong>${Math.round(cfg.cp)}%</strong></span>
      <span class="chip">Output: <strong>${Math.round(cfg.op)}%</strong></span>
      <span class="chip">Budget: <strong>€${fmtMoney(cfg.budget)}</strong></span>`;
  }

  // ── Full render: rebuilds rows (filters / search / sort changed) ──────
  // Rebuilding innerHTML wipes any expanded drill-down (standard behaviour when
  // the row set changes) but keeps the delegated click listener on <tbody>.
  function render() {
    const cfg = getConfig();
    const rows = ALL_MODELS.filter(passesFilters).map(m => {
      const cost = estimateCost(m, cfg);
      const runs = cost > 0 ? cfg.budget / cost : null;   // free-model guard, no /0
      return { ...m, cost, runs };
    });
    sortRows(rows);
    const maxCost = rows.reduce((mx, r) => Math.max(mx, r.cost), 0) || 1;

    document.getElementById('table-body').innerHTML = rows.map(m => {
      const inCmp   = state.compareIds.has(m.id);
      const cmpCls  = inCmp ? 'cmp-btn active' : 'cmp-btn';
      const cmpIcon = inCmp ? '−' : '+';
      const rowCls  = inCmp ? 'model-row in-compare' : 'model-row';
      return `
      <tr class="${rowCls}" data-id="${m.id}">
        <td class="cmp-cell">
          <button class="${cmpCls}" title="${inCmp ? 'Remove from comparison' : 'Add to comparison'}"
            onclick="toggleCompare('${m.id}')">${cmpIcon}</button>
        </td>
        <td class="model-id">${m.id}</td>
        <td class="owner">${m.owned_by}</td>
        <td class="caps">${capabilityBadges(m)}${quantChip(m)}</td>
        <td class="num col-input">${rate(m.input)}</td>
        <td class="num col-cached">${rate(m.cached)}</td>
        <td class="num col-output">${rate(m.output)}</td>
        <td class="num cost-cell">${m.cost > 0 ? `€${fmt(m.cost)}` : 'Free'}</td>
        <td class="num runs-cell">${m.runs != null ? fmtRuns(m.runs) : '—'}</td>
        <td class="bar-cell bar-fill-cell">${barHtml(m.cost, maxCost)}</td>
      </tr>`;
    }).join('');

    document.getElementById('no-results').style.display = rows.length ? 'none' : 'block';
    document.getElementById('row-count').innerHTML =
      `Showing <strong>${rows.length}</strong> of <strong>${ALL_MODELS.length}</strong> models`;

    document.querySelectorAll('thead th[data-col]').forEach(th => {
      th.classList.remove('sort-asc', 'sort-desc');
      const icon = th.querySelector('.sort-icon');
      if (th.dataset.col === state.sortCol) {
        th.classList.add(state.sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
        if (icon) icon.textContent = state.sortDir === 'asc' ? '↑' : '↓';
      } else if (icon) {
        icon.textContent = '↕';
      }
    });

    summaryChips(cfg);
    applyColumnVisibility();
    renderCompareTray(cfg);
  }

  // ── Light recompute: budget controls changed, keep rows + drills intact ──
  // Only touches cost / runs / bar cells. The bar rescales to the most expensive
  // model currently visible (the filtered set), per plan.md "Relative-cost bar".
  function recompute() {
    const cfg = getConfig();
    const trs = Array.from(document.querySelectorAll('#table-body tr.model-row'));
    const byId = id => ALL_MODELS.find(x => x.id === id);
    const costs = trs.map(tr => estimateCost(byId(tr.dataset.id), cfg));
    const maxCost = costs.reduce((mx, c) => Math.max(mx, c), 0) || 1;

    trs.forEach((tr, i) => {
      const cost = costs[i];
      const runs = cost > 0 ? cfg.budget / cost : null;
      tr.querySelector('.cost-cell').textContent = cost > 0 ? `€${fmt(cost)}` : 'Free';
      tr.querySelector('.runs-cell').textContent = runs != null ? fmtRuns(runs) : '—';
      tr.querySelector('.bar-fill-cell').innerHTML = barHtml(cost, maxCost);
    });

    summaryChips(cfg);
    renderCompareTray(cfg);
  }

  // ── Drill-down (click a model row to expand its providers) ───────────
  function onRowClick(e) {
    if (e.target.closest('.cmp-btn')) return;   // "+" toggles compare, never the drill-down
    const tr = e.target.closest('tr.model-row');
    if (!tr) return;                       // ignore clicks inside a drill-down row
    const next = tr.nextElementSibling;
    if (next && next.classList.contains('drilldown-row')) {
      next.remove();                       // collapse
      tr.classList.remove('expanded');
      return;
    }
    const m = ALL_MODELS.find(x => x.id === tr.dataset.id);
    const rows = (m.providers || []).map(providerRowHtml).join('')
      || '<tr class="provider-row"><td colspan="10" class="dim">No provider detail</td></tr>';
    const drill = document.createElement('tr');
    drill.className = 'drilldown-row';
    drill.innerHTML = `<td colspan="10">
      <table class="provider-table">
        <thead><tr>
          <th>Provider</th>
          <th class="num">Input €/1M</th>
          <th class="num">Cached €/1M</th>
          <th class="num">Output €/1M</th>
          <th>Quant</th>
          <th class="num">Context</th>
          <th>Features</th>
          <th>Audio</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table></td>`;
    tr.after(drill);
    tr.classList.add('expanded');
  }

  function providerRowHtml(p) {
    const ctx  = p.context_size ? p.context_size.toLocaleString() : '—';
    const feats = (p.features || []).join(', ') || '—';
    // Audio models carry audio_cost (€/s) and optionally speech_cost (€/1M chars);
    // these don't fit the token columns, so they live only in the drill-down.
    let audio = '';
    if (p.audio_cost != null) {
      audio = `€${fmt(p.audio_cost)}/s`;
      if (p.speech_cost != null) audio += ` · €${fmt(p.speech_cost)}/1M chars`;
    }
    return `
      <tr class="provider-row">
        <td>${p.name}${providerBadges(p.name)}</td>
        <td class="num">${rate(p.input)}</td>
        <td class="num">${rate(p.cached)}</td>
        <td class="num">${rate(p.output)}</td>
        <td>${p.quantization || '—'}</td>
        <td class="num">${ctx}</td>
        <td>${feats}</td>
        <td>${audio}</td>
      </tr>`;
  }

  // ── Column visibility (mirror app.js.j2) ────────────────────────────
  function applyColumnVisibility() {
    const t = document.getElementById('cortecs-table');
    t.classList.toggle('hide-input', !state.showInput);
    t.classList.toggle('hide-cached', !state.showCached);
    t.classList.toggle('hide-output', !state.showOutput);
    [['toggle-input-col', 'showInput'],
     ['toggle-cached-col', 'showCached'],
     ['toggle-output-col', 'showOutput']].forEach(([id, key]) => {
      const el = document.getElementById(id);
      if (el) el.checked = state[key];
    });
  }

  // ── Compare tray (mirror app.js.j2) ────────────────────────────────
  // Pins models by id (string) rather than the GitHub tool's numeric _idx; the
  // Cortecs rows already key everything on data-id. Cap = 5 (plan.md).
  const MAX_COMPARE = 5;

  function toggleCompare(id) {
    if (state.compareIds.has(id)) {
      state.compareIds.delete(id);
    } else {
      if (state.compareIds.size >= MAX_COMPARE) return;   // reject past cap
      state.compareIds.add(id);
    }
    render();
  }

  function clearCompare() {
    state.compareIds.clear();
    render();
  }

  // Tray card: each pinned model's cheapest-provider prices + the budget
  // figures (est. cost / run, runs the budget buys) side by side. Re-runs on
  // every render() and recompute() so budget changes flow through.
  function renderCompareTray(cfg) {
    const tray  = document.getElementById('compare-tray');
    const cards = document.getElementById('tray-cards');
    const count = state.compareIds.size;

    document.getElementById('tray-count').textContent = count;

    if (count === 0) {
      tray.classList.remove('visible');
      document.body.classList.remove('tray-open');
      return;
    }

    tray.classList.add('visible');
    document.body.classList.add('tray-open');

    const compared = [...state.compareIds]
      .map(id => ALL_MODELS.find(x => x.id === id))
      .filter(Boolean)
      .map(m => {
        const cost = estimateCost(m, cfg);
        const runs = cost > 0 ? cfg.budget / cost : null;   // free-model guard
        return { ...m, cost, runs };
      });

    const maxInput  = Math.max(1, ...compared.map(m => m.input));
    const maxCached = Math.max(1, ...compared.map(m => m.cached));
    const maxOutput = Math.max(1, ...compared.map(m => m.output));
    const minCost   = Math.min(...compared.map(m => m.cost));

    cards.innerHTML = compared.map(m => {
      const isCheapest = compared.length > 1 && m.cost === minCost;
      const inBarW  = m.input  > 0 ? Math.round((m.input  / maxInput)  * 100) : 0;
      const caBarW  = m.cached > 0 ? Math.round((m.cached / maxCached) * 100) : 0;
      const outBarW = m.output > 0 ? Math.round((m.output / maxOutput) * 100) : 0;
      const runsLabel = m.runs != null ? fmtRuns(m.runs) : '—';
      return `
      <div class="cmp-card">
        <button class="cmp-card-remove" title="Remove" onclick="toggleCompare('${m.id}')">✕</button>
        <div class="cmp-card-name">${m.id}</div>
        <div class="cmp-card-provider">${m.owned_by || ''}</div>
        <div class="cmp-card-rows">
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Input</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill ${isCheapest ? 'highlight' : ''}" style="width:${inBarW}%"></div></div>
            <span class="cmp-rate-val">${rate(m.input)}</span>
          </div>
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Cached</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill ${isCheapest ? 'highlight' : ''}" style="width:${caBarW}%"></div></div>
            <span class="cmp-rate-val">${rate(m.cached)}</span>
          </div>
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Output</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill ${isCheapest ? 'highlight' : ''}" style="width:${outBarW}%"></div></div>
            <span class="cmp-rate-val">${rate(m.output)}</span>
          </div>
        </div>
        <div class="cmp-card-cost">
          <div>
            <div class="cmp-cost-label">Est. cost / run</div>
            <div class="cmp-credits">${runsLabel} runs in budget</div>
          </div>
          <span class="cmp-cost-val ${isCheapest ? 'cheapest' : ''}">${m.cost > 0 ? '€' + fmt(m.cost) : 'Free'}</span>
        </div>
      </div>`;
    }).join('');

    if (count < MAX_COMPARE) {
      cards.innerHTML += `
      <div class="cmp-card cmp-card-add">
        <span class="cmp-card-add-icon">+</span>
        Click <strong>+</strong> on any row to add
      </div>`;
    }
  }

  // ── Event wiring ───────────────────────────────────────────────────
  // Sort: click a column header; repeat click flips direction (mirror GitHub tool).
  document.querySelectorAll('thead th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.col;
      if (state.sortCol === col) {
        state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        state.sortCol = col;
        state.sortDir = 'asc';
      }
      render();
    });
  });

  // Filter chips: each is a toggle; multiple combine with AND.
  document.getElementById('filter-chips').addEventListener('click', e => {
    const btn = e.target.closest('.filter-chip');
    if (!btn) return;
    const key = btn.dataset.filter;
    state.filters[key] = !state.filters[key];
    btn.classList.toggle('active', state.filters[key]);
    render();
  });

  // Free-text search by model name and owner.
  document.getElementById('search-input').addEventListener('input', e => {
    state.search = e.target.value;
    render();
  });

  // Column show/hide toggles (CSS only — rows and drills stay put).
  [['toggle-input-col', 'showInput'],
   ['toggle-cached-col', 'showCached'],
   ['toggle-output-col', 'showOutput']].forEach(([id, key]) => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', e => {
      state[key] = e.target.checked;
      applyColumnVisibility();
    });
  });

  // Profile preset buttons
  document.querySelectorAll('.profile-btn').forEach(btn => {
    btn.addEventListener('click', () => setProfile(btn.dataset.profile));
  });

  // Token-mix inputs clear the active profile on manual edit
  ['total-tokens', 'input-pct', 'cached-pct', 'output-pct'].forEach(id => {
    document.getElementById(id).addEventListener('input', e => {
      state.activeProfile = null;
      document.querySelectorAll('.profile-btn').forEach(btn => btn.classList.remove('active'));
      recompute();
    });
  });

  // Budget alone does not affect the token-mix profile, so it skips the clear
  document.getElementById('budget-amount').addEventListener('input', recompute);

  // Delegated drill-down toggle — attached once on the <tbody>; survives the
  // innerHTML rebuilds render() does because the listener lives on the element.
  document.getElementById('table-body').addEventListener('click', onRowClick);

  // ── Initial render ─────────────────────────────────────────────────
  render();
</script>
