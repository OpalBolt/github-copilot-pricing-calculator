{% import 'macros.html.j2' as m %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cortecs · Model price calculator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,wght@1,500&display=swap" rel="stylesheet" />
  {% include 'styles.css.j2' %}
  {# ponytail: scoped table override; later slices fold cortecs styles into styles.css.j2 #}
  <style>
    #cortecs-table { table-layout: auto; }
    #cortecs-table th, #cortecs-table td { white-space: nowrap; }
    /* model ids are long kebab-case; let them wrap instead of overflowing into Owner */
    #cortecs-table td.model-id { white-space: normal; overflow-wrap: anywhere; }
    /* "+" column: narrow + centered (cmp-btn itself is shared) */
    #cortecs-table th.cmp-col, #cortecs-table td.cmp-cell { width: 40px; text-align: center; padding: 8px; }
    #cortecs-table td.owner { color: var(--slate-5); }
    /* bar cell needs to breathe despite the nowrap above */
    #cortecs-table td.bar-cell { white-space: normal; }
    /* column show/hide (mirror the #main-table rules for the Cortecs table) */
    #cortecs-table.hide-input .col-input,
    #cortecs-table.hide-cached .col-cached,
    #cortecs-table.hide-output .col-output { display: none; }

    /* ── Provider drill-down (slice 04) ── */
    #cortecs-table tr.model-row { cursor: pointer; }
    #cortecs-table tr.model-row:hover td { background: var(--slate-1, #f1f5f9); }
    #cortecs-table tr.model-row.expanded td { border-bottom-style: dashed; }
    #cortecs-table tr.drilldown-row > td { padding: 0; background: var(--slate-1, #f8fafc); }
    .provider-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .provider-table th { text-align: left; font-weight: 600; color: var(--slate-5);
                          padding: 6px 10px; border-bottom: 1px solid var(--slate-2, #e2e8f0);
                          white-space: nowrap; }
    .provider-table td { padding: 5px 10px; white-space: nowrap; }
    .provider-table td:last-child { white-space: normal; } /* features can wrap */
    .badge-eu, .badge-zdr { margin-left: 4px; font-size: 12px; white-space: nowrap; }
    .provider-table .dim { color: var(--slate-4, #94a3b8); }

    /* ── Row badges (slice 05): capability + heavy-quant chips ── */
    #cortecs-table td.caps { white-space: normal; }
    .cap {
      display: inline-block; font-size: 10px; font-weight: 600;
      letter-spacing: 0.04em; text-transform: uppercase;
      padding: 2px 6px; margin: 0 3px 2px 0; border-radius: 3px;
      background: var(--slate-2, #eef2f7); color: var(--slate-6, #475569);
      border: 1px solid var(--slate-3, #dbe3ec);
    }
    .quant-chip {
      display: inline-block; font-size: 10px; font-weight: 600;
      padding: 2px 6px; margin: 0 0 2px 0; border-radius: 3px;
      background: var(--slate-1, #f8fafc); color: var(--slate-5, #64748b);
      border: 1px dashed var(--slate-3, #cbd5e1);
    }
  </style>
</head>
<body>

<!-- ── Header ──────────────────────────────────────────────── -->
<header class="page-header">
  <p class="eyebrow">Cortecs · € per 1M tokens</p>
  <h1>Model price calculator</h1>
  <p>Every Cortecs model at its cheapest available provider price. All prices are in euros per 1 million tokens.</p>
  <p class="meta"><a href="index.html">← All tools</a> · Source: <a href="{{ source }}" target="_blank">api.cortecs.ai · /v1/models</a> · Data fetched: <span id="fetch-date">{{ fetchDate }}</span></p>
</header>

<!-- ── Main ────────────────────────────────────────────────── -->
<main>
  <!-- Controls (budget machinery, mirrored from the GitHub tool, in €) -->
  <div class="controls">
    <h2>Configure your estimate</h2>
      <div class="profile-presets">
        <span class="profile-label">Quick presets:</span>
        <div class="profile-buttons">
          <button class="profile-btn" data-profile="superuser">Superuser/Developer</button>
          <button class="profile-btn" data-profile="regular">Regular User</button>
        </div>
      </div>
    <div class="controls-grid">
      {{ m.input_group('total-tokens', 'Total tokens', 1000000, 1, none, 100000) }}
      {{ m.input_group('input-pct', 'Input %', 20, 0, 100, 0.1) }}
      {{ m.input_group('cached-pct', 'Cached %', 60, 0, 100, 0.1) }}
      {{ m.input_group('output-pct', 'Output %', 20, 0, 100, 0.1) }}
      {{ m.input_group('budget-amount', 'Budget (€)', 50, 0, none, 0.01) }}
    </div>
    <div class="summary-chips" id="summary-chips"></div>
    <div id="pct-warning" style="display: none; margin-top: 12px; padding: 8px 12px; background: #FEF9C3; border: 1px solid #EAB308; border-radius: 4px; font-size: 13px; color: #854D0E;">
      ⚠️ Input, Cached, and Output percentages must sum to 100%
    </div>
  </div>

  <!-- Filters + search + column toggles (slice 05). Chips are toggles that AND together. -->
  <div class="filters-bar">
    <div class="filter-group">
      <span class="filter-label">Filter</span>
      <div class="filter-chips" id="filter-chips">
        <button class="filter-chip" data-filter="sovereign" title="Only models with at least one EU-sovereign provider">🇪🇺 Sovereign-only</button>
        <button class="filter-chip" data-filter="zdr" title="Only models with at least one zero-data-retention provider">🔒 ZDR</button>
        <button class="filter-chip" data-filter="reasoning">Reasoning</button>
        <button class="filter-chip" data-filter="tools">Tools</button>
        <button class="filter-chip" data-filter="vision">Vision</button>
        <button class="filter-chip" data-filter="audio">Audio</button>
      </div>
    </div>
    <div class="search-wrap">
      <input type="search" id="search-input" placeholder="Search model or owner…" />
    </div>
    <div class="column-toggle-group" aria-label="Table columns">
      <span class="filter-label">Columns</span>
      <div class="column-toggle-chips">
        <label class="column-toggle-chip" for="toggle-input-col">
          <input type="checkbox" id="toggle-input-col" checked />
          <span>Input</span>
        </label>
        <label class="column-toggle-chip" for="toggle-cached-col">
          <input type="checkbox" id="toggle-cached-col" checked />
          <span>Cached</span>
        </label>
        <label class="column-toggle-chip" for="toggle-output-col">
          <input type="checkbox" id="toggle-output-col" checked />
          <span>Output</span>
        </label>
      </div>
    </div>
  </div>

  <div class="table-meta">
    <span class="table-meta-count" id="row-count"></span>
  </div>

  <div class="table-wrapper">
    <table id="cortecs-table">
      <thead>
        <tr>
          <th class="cmp-col" title="Add to compare tray"></th>
          <th class="sortable" data-col="id">Model <span class="sort-icon">↕</span></th>
          <th class="sortable" data-col="owned_by">Owner <span class="sort-icon">↕</span></th>
          <th>Capabilities</th>
          <th class="sortable num col-input" data-col="input">Input €/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num col-cached" data-col="cached">Cached €/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num col-output" data-col="output">Output €/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="cost" title="Estimated € cost for one run of your configured token mix (Total tokens × Input/Cached/Output %).">Est. cost <span class="sort-icon">↕</span></th>
          <th class="num" title="How many times you could repeat your token mix within your budget (Budget ÷ Est. cost).">Runs</th>
          <th class="bar-cell" title="Bar length is cost relative to the most expensive model in the current view.">Relative cost</th>
        </tr>
      </thead>
      <tbody id="table-body"></tbody>
    </table>
    <div class="no-results" id="no-results">No models match your filters.</div>
  </div>

  <p class="page-note">
    Est. cost = (input tokens × input rate + cached tokens × cached rate + output tokens × output rate) ÷ 1M, from your token split above.
    Rates are € per 1M tokens. Cached reuses the provider's cache-read rate where published, otherwise the input rate.
    Runs = Budget ÷ Est. cost. Free models (€0) show “Free” and never divide by zero.
    Prices shown are the cheapest available provider for each model; Cortecs also offers fastest and balanced routing.
    Click any model row to expand its providers — per-provider price, quantization, context size, features, and audio cost; 🇪🇺 marks EU-sovereign providers, 🔒 marks zero-data-retention.
    A muted <strong>fp4</strong>/<strong>int4</strong> chip marks models whose cheapest provider uses heavy quantization — the detail behind every price is in the drill-down.
  </p>
</main>

<footer class="page-footer">
  <span>Cortecs · Model price calculator · Data sourced from the Cortecs models API</span>
  <a href="{{ source }}" target="_blank">View source API →</a>
</footer>


<!-- ── Compare tray ─────────────────────────────────────────── -->
<div id="compare-tray" role="region" aria-label="Model comparison">
  <div class="tray-header">
    <span class="tray-title">Comparing <span id="tray-count">0</span> models</span>
    <div class="tray-actions">
      <button class="tray-clear" onclick="clearCompare()">Clear all</button>
    </div>
  </div>
  <div class="tray-cards" id="tray-cards"></div>
</div>
{% include 'cortecs.app.js.j2' %}

</body>
</html>
