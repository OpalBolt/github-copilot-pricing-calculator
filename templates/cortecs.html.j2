{% import 'macros.html.j2' as m %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cortecs · Model price calculator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,wght@1,500&display=swap" rel="stylesheet" />
  {% include 'styles.css.j2' %}
  {# ponytail: scoped table override; later slices fold cortecs styles into styles.css.j2 #}
  <style>
    #cortecs-table { table-layout: auto; }
    #cortecs-table th, #cortecs-table td { white-space: nowrap; }
    #cortecs-table td.owner { color: var(--slate-5); }
    /* bar cell needs to breathe despite the nowrap above */
    #cortecs-table td.bar-cell { white-space: normal; }

    /* ── Provider drill-down (slice 04) ── */
    #cortecs-table tr.model-row { cursor: pointer; }
    #cortecs-table tr.model-row:hover td { background: var(--slate-1, #f1f5f9); }
    #cortecs-table tr.model-row.expanded td { border-bottom-style: dashed; }
    #cortecs-table tr.drilldown-row > td { padding: 0; background: var(--slate-1, #f8fafc); }
    .provider-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .provider-table th { text-align: left; font-weight: 600; color: var(--slate-5);
                          padding: 6px 10px; border-bottom: 1px solid var(--slate-2, #e2e8f0);
                          white-space: nowrap; }
    .provider-table td { padding: 5px 10px; white-space: nowrap; }
    .provider-table td:last-child { white-space: normal; } /* features can wrap */
    .badge-eu, .badge-zdr { margin-left: 4px; font-size: 12px; white-space: nowrap; }
    .provider-table .dim { color: var(--slate-4, #94a3b8); }
  </style>
</head>
<body>

<!-- ── Header ──────────────────────────────────────────────── -->
<header class="page-header">
  <p class="eyebrow">Cortecs · € per 1M tokens</p>
  <h1>Model price calculator</h1>
  <p>Every Cortecs model at its cheapest available provider price. All prices are in euros per 1 million tokens.</p>
  <p class="meta"><a href="index.html">← All tools</a> · Source: <a href="{{ source }}" target="_blank">api.cortecs.ai · /v1/models</a> · Data fetched: <span id="fetch-date">{{ fetchDate }}</span></p>
</header>

<!-- ── Main ────────────────────────────────────────────────── -->
<main>
  <!-- Controls (budget machinery, mirrored from the GitHub tool, in €) -->
  <div class="controls">
    <h2>Configure your estimate</h2>
    <div class="controls-grid">
      {{ m.input_group('total-tokens', 'Total tokens', 1000000, 1, none, 100000) }}
      {{ m.input_group('input-pct', 'Input %', 20, 0, 100, 0.1) }}
      {{ m.input_group('cached-pct', 'Cached %', 60, 0, 100, 0.1) }}
      {{ m.input_group('output-pct', 'Output %', 20, 0, 100, 0.1) }}
      {{ m.input_group('budget-amount', 'Budget (€)', 50, 0, none, 0.01) }}
    </div>
    <div class="summary-chips" id="summary-chips"></div>
    <div id="pct-warning" style="display: none; margin-top: 12px; padding: 8px 12px; background: #FEF9C3; border: 1px solid #EAB308; border-radius: 4px; font-size: 13px; color: #854D0E;">
      ⚠️ Input, Cached, and Output percentages must sum to 100%
    </div>
  </div>

  <div class="table-meta">
    <span class="table-meta-count"><strong>{{ models|length }}</strong> models</span>
  </div>

  <div class="table-wrapper">
    <table id="cortecs-table">
      <thead>
        <tr>
          <th>Model</th>
          <th>Owner</th>
          <th class="num">Input €/1M</th>
          <th class="num">Cached €/1M</th>
          <th class="num">Output €/1M</th>
          <th class="num" title="Estimated € cost for one run of your configured token mix (Total tokens × Input/Cached/Output %).">Est. cost</th>
          <th class="num" title="How many times you could repeat your token mix within your budget (Budget ÷ Est. cost).">Runs</th>
          <th class="bar-cell" title="Bar length is cost relative to the most expensive model in the current view.">Relative cost</th>
        </tr>
      </thead>
      <tbody id="table-body"></tbody>
    </table>
  </div>

  <p class="page-note">
    Est. cost = (input tokens × input rate + cached tokens × cached rate + output tokens × output rate) ÷ 1M, from your token split above.
    Rates are € per 1M tokens. Cached reuses the provider's cache-read rate where published, otherwise the input rate.
    Runs = Budget ÷ Est. cost. Free models (€0) show “Free” and never divide by zero.
    Prices shown are the cheapest available provider for each model; Cortecs also offers fastest and balanced routing.
    Click any model row to expand its providers — per-provider price, quantization, context size, features, and audio cost; 🇪🇺 marks EU-sovereign providers, 🔒 marks zero-data-retention.
  </p>
</main>

<footer class="page-footer">
  <span>Cortecs · Model price calculator · Data sourced from the Cortecs models API</span>
  <a href="{{ source }}" target="_blank">View source API →</a>
</footer>

{% include 'cortecs.app.js.j2' %}

</body>
</html>
