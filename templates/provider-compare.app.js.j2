<script>
  // ── Provider data (baked from providers.json at generate time) ──
  const PROVIDERS = {{ providers | tojson }};
  const SUBS = PROVIDERS.filter(p => p.pricing_type === 'subscription');

  const PRESETS = {
    superuser: { name: 'Superuser/Developer', input: 0.49, cached: 98.62, output: 0.89 },
    regular:  { name: 'Regular User', input: 5.45, cached: 86.36, output: 8.18 },
  };

  // ── Helpers ──────────────────────────────────────────────────
  const fmtCompact = n => {
    const abs = Math.abs(n);
    if (!Number.isFinite(n)) return '—';
    if (abs >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(1)}B`;
    if (abs >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
    if (abs >= 1_000) return `${(n / 1_000).toFixed(1)}K`;
    return `${n.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
  };
  const fmtInt = n => Number.isFinite(n) ? Math.round(n).toLocaleString('en-US') : '—';
  const fmtPrice = n => {
    if (!Number.isFinite(n)) return '—';
    return n < 0.01 ? `$${n.toFixed(4)}` : `$${n.toFixed(2)}`;
  };


  // ── State ────────────────────────────────────────────────────
  const state = {
    sortCol: 'relative',      // cheapest first on load
    sortDir: 'asc',
    search: '',
    hiddenProviders: new Set(),
    showAll: false,
    compare: new Set(),       // row elements in the compare tray
  };

  // ── Config & per-row compute ─────────────────────────────────
  function getConfig() {
    const budget = Math.max(0, parseFloat(document.getElementById('budget-amount').value) || 0);
    const input  = parseFloat(document.getElementById('input-pct').value)  || 0;
    const cached = parseFloat(document.getElementById('cached-pct').value) || 0;
    const output = parseFloat(document.getElementById('output-pct').value) || 0;
    const tokensPerRun = Math.max(0, parseFloat(document.getElementById('tokens-per-run').value) || 0);

    const warning = document.getElementById('pct-warning');
    warning.style.display = Math.abs(input + cached + output - 100) > 0.1 ? 'block' : 'none';

    const tierSel = (document.querySelector('input[name="tier"]:checked') || {}).value || null;
    const offPeak = document.getElementById('off-peak-toggle')?.checked || false;
    return { budget, input, cached, output, tokensPerRun, tierSel, offPeak };
  }

  // Returns { cost, runs, tokens, ip, cp, op, plan, free, surplus } for a row.
  // Paygo: cost = USD per run, runs/tokens scale with budget. Subscription:
  // cost = tier.monthly_usd, runs = months the budget buys, tokens = months × the
  // monthly token cap; surplus set when the budget exceeds one month's price.
  // null cost = uncomputable (e.g. subscription provider missing the selected tier).
  function computeRow(row, cfg) {
    const out = { cost: null, runs: null, tokens: null, ip: null, cp: null, op: null, plan: null, free: false };

    if (row.dataset.pricingType === 'subscription') {
      if (!SUBS.length || !cfg.tierSel) return out;
      const prov = SUBS.find(p => p.id === row.dataset.providerId);
      const tier = prov && prov.tiers.find(t => t.name === cfg.tierSel);
      if (!prov || !tier) return out;

      const mi = parseFloat(row.dataset.multInput), mc = parseFloat(row.dataset.multCached), mo = parseFloat(row.dataset.multOutput);

      // Free model: all multipliers zero, skip math
      if (mi === 0 && mc === 0 && mo === 0) { out.free = true; out.plan = cfg.tierSel; out.ip = out.cp = out.op = 0; out.cost = 0; return out; }

      const creditsPer1MFor = mix => {
        const weighted = mix.input / 100 * mi + mix.cached / 100 * mc + mix.output / 100 * mo;
        if (weighted === 0) return 0;
        let creditsPer1M = weighted * 1_000_000 / 10_000;
        if (cfg.offPeak) creditsPer1M *= prov.off_peak_multiplier || 1;
        return creditsPer1M;
      };
      const priceFor = mix => {
        const creditsPer1M = creditsPer1MFor(mix);
        if (creditsPer1M === 0) return 0;
        const weeklyCost = tier.monthly_usd / 4.33;
        const tokensPerWeek = tier.weekly_credits / creditsPer1M * 1_000_000;
        return weeklyCost / (tokensPerWeek / 1_000_000);
      };

      out.plan = cfg.tierSel;
      out.ip = priceFor({ input: 100, cached: 0, output: 0 });
      out.cp = priceFor({ input: 0, cached: 100, output: 0 });
      out.op = priceFor({ input: 0, cached: 0, output: 100 });

      // Subscription: Est. cost = the actual monthly plan price. Runs = months the
      // budget buys; Tokens = months × one month's capped token pool.
      out.cost = tier.monthly_usd;
      out.runs = cfg.budget / tier.monthly_usd;
      const creditsPer1M = creditsPer1MFor(cfg);
      if (creditsPer1M > 0) {
        // ponytail: credits/week is binding constraint, tokens cap per subscription period
        out.tokens = out.runs * tier.weekly_credits / creditsPer1M * 1_000_000 * 4.33;
      }
      if (cfg.budget > tier.monthly_usd) out.surplus = tier.monthly_usd;
    } else {
      out.plan = 'Paygo';
      out.ip = parseFloat(row.dataset.inputPrice);
      out.cp = parseFloat(row.dataset.cachedPrice);
      out.op = parseFloat(row.dataset.outputPrice);

      // Free model: all prices zero, skip math
      if (out.ip === 0 && out.cp === 0 && out.op === 0) { out.free = true; out.cost = 0; return out; }

      const blended = (cfg.input * out.ip + cfg.cached * out.cp + cfg.output * out.op) / 100;
      out.cost = blended * cfg.tokensPerRun / 1_000_000;
      if (out.cost > 0) {
        out.runs = cfg.budget / out.cost;
        out.tokens = out.runs * cfg.tokensPerRun;
      }
    }
    return out;
  }

  // ── Fill the table ───────────────────────────────────────────
  // Cell order: 0 cmp btn · 1 provider · 2 plan · 3 model · 4-6 prices · 7 est · 8 runs · 9 tokens · 10 rel
  function updateRows() {
    const cfg = getConfig();
    document.querySelectorAll('#provider-table tbody tr').forEach(row => {
      const c = computeRow(row, cfg);
      row._computed = c;
      const cells = row.children;

      // Surplus subscription: budget buys more than one month, Runs/Tokens are capped per period
      const cappedSub = row.dataset.pricingType === 'subscription' && c.surplus != null;
      row.classList.toggle('surplus', cappedSub);
      const capNote = cappedSub ? 'Capped at one subscription period (monthly credit pool)' : '';

      if (row.dataset.pricingType === 'subscription') {
        cells[2].textContent = c.plan || '—';
        [cells[4], cells[5], cells[6]].forEach((cell, i) => {
          const p = [c.ip, c.cp, c.op][i];
          if (p == null || !Number.isFinite(p)) { cell.textContent = '—'; cell.dataset.sort = ''; }
          else { cell.textContent = fmtPrice(p); cell.dataset.sort = p; }
        });
      }

      const [costCell, runsCell, tokensCell] = [cells[7], cells[8], cells[9]];
      runsCell.title = tokensCell.title = capNote;

      if (c.free) {
        costCell.textContent = 'Free';  costCell.dataset.sort = 0;
        runsCell.textContent = '—';     runsCell.dataset.sort = '';
        tokensCell.textContent = '—';   tokensCell.dataset.sort = '';
      } else if (c.cost != null) {
        costCell.textContent = fmtPrice(c.cost); costCell.dataset.sort = c.cost;
        runsCell.textContent = c.runs != null ? fmtInt(c.runs) : '—';
        runsCell.dataset.sort = c.runs != null ? c.runs : '';
        tokensCell.textContent = c.tokens != null ? fmtCompact(c.tokens) : '—';
        tokensCell.dataset.sort = c.tokens != null ? c.tokens : '';
      } else {
        costCell.textContent = '—'; costCell.dataset.sort = '';
        runsCell.textContent = '—'; runsCell.dataset.sort = '';
        tokensCell.textContent = '—'; tokensCell.dataset.sort = '';
      }
    });
    return cfg;
  }

  // Relative cost bars: est_cost / max(visible est_cost) × 100%.
  // Free models get a zero-width "Free" bar. Value shown is USD.
  function updateBars() {
    let max = 0;
    document.querySelectorAll('#provider-table tbody tr').forEach(row => {
      if (row.classList.contains('hidden-row')) return;
      const c = row._computed;
      if (c && c.cost != null && c.cost > max) max = c.cost;
    });
    document.querySelectorAll('#provider-table tbody tr').forEach(row => {
      const c = row._computed;
      const cell = row.children[10];
      if (!c || c.cost == null) { cell.innerHTML = '—'; cell.dataset.sort = ''; return; }
      const w = max > 0 ? Math.round(c.cost / max * 100) : 0;
      const val = c.free ? 'Free' : fmtPrice(c.cost);
      cell.innerHTML =
        `<div class="credit-bar-wrap"><div class="credit-bar-bg"><div class="credit-bar-fill" style="width:${w}%"></div></div>` +
        `<span class="credit-val">${val}</span></div>`;
      cell.dataset.sort = c.cost;
    });
  }

  function recompute() {
    updateRows();
    applyFilters();
    updateBars();
    applySort();
    updateCompareUI();
  }

  // ── Filters & sort ───────────────────────────────────────────
  // Raw numeric value of a cell for sorting; '' / missing = no value
  // (sorts last, same as the copilot tool).
  const cellNum = td => {
    const v = td.dataset.sort;
    if (v === undefined || v === '') return null;
    return +v;
  };
  const COLUMN_GET = {
    provider: tr => tr.children[1].textContent.trim(),
    plan:     tr => tr.children[2].textContent.trim(),
    model:    tr => tr.children[3].textContent.trim(),
    input:    tr => cellNum(tr.children[4]),
    cached:   tr => cellNum(tr.children[5]),
    output:   tr => cellNum(tr.children[6]),
    cost:     tr => cellNum(tr.children[7]),
    runs:     tr => cellNum(tr.children[8]),
    tokens:   tr => cellNum(tr.children[9]),
    relative: tr => cellNum(tr.children[10]),
  };

  // A row is visible only when: provider chip active AND model matches
  // search AND (show-all toggle on OR default_visible).
  function applyFilters() {
    const q = state.search.toLowerCase();
    document.querySelectorAll('#provider-table tbody tr').forEach(tr => {
      const defaultOk  = state.showAll || tr.dataset.defaultVisible === 'true';
      const providerOk = !state.hiddenProviders.has(tr.dataset.providerId);
      const searchOk   = !q
        || tr.dataset.modelId.toLowerCase().includes(q)
        || tr.dataset.providerName.toLowerCase().includes(q);
      const visible = defaultOk && providerOk && searchOk;
      tr.classList.toggle('hidden-default', !defaultOk);
      tr.classList.toggle('hidden-row', !visible);
    });
  }

  function applySort() {
    if (!state.sortCol) return;
    const get = COLUMN_GET[state.sortCol];
    const dir = state.sortDir === 'asc' ? 1 : -1;
    const tbody = document.querySelector('#provider-table tbody');
    [...tbody.children].sort((a, b) => {
      const av = get(a), bv = get(b);
      if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return String(av).localeCompare(String(bv)) * dir;
    }).forEach(tr => tbody.appendChild(tr));
  }

  function updateSortIndicators() {
    document.querySelectorAll('#provider-table thead th[data-col]').forEach(th => {
      th.classList.remove('sort-asc', 'sort-desc');
      const icon = th.querySelector('.sort-icon');
      if (th.dataset.col === state.sortCol) {
        th.classList.add(state.sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
        if (icon) icon.textContent = state.sortDir === 'asc' ? '↑' : '↓';
      } else if (icon) {
        icon.textContent = '↕';
      }
    });
  }

  function updateShowAllLabel() {
    const n = document.querySelectorAll('#provider-table tbody tr[data-default-visible="false"]').length;
    document.getElementById('show-all-label').textContent =
      state.showAll || n === 0 ? 'Show all models' : `Show ${n} more models`;
  }

  // ── Compare tray ─────────────────────────────────────────────
  const MAX_COMPARE = 5;

  function toggleCompare(row) {
    if (state.compare.has(row)) {
      state.compare.delete(row);
    } else {
      if (state.compare.size >= MAX_COMPARE) return;
      state.compare.add(row);
    }
    updateCompareUI();
  }

  function clearCompare() {
    state.compare.clear();
    updateCompareUI();
  }

  function updateCompareUI() {
    document.querySelectorAll('#provider-table tbody tr').forEach(row => {
      const inCmp = state.compare.has(row);
      row.classList.toggle('in-compare', inCmp);
      const btn = row.querySelector('.cmp-btn');
      if (btn) {
        btn.classList.toggle('active', inCmp);
        btn.textContent = inCmp ? '−' : '+';
        btn.title = inCmp ? 'Remove from comparison' : 'Add to comparison';
      }
    });

    const tray = document.getElementById('compare-tray');
    const cards = document.getElementById('tray-cards');
    document.getElementById('tray-count').textContent = state.compare.size;

    if (state.compare.size === 0) {
      tray.classList.remove('visible');
      document.body.classList.remove('tray-open');
      cards.innerHTML = '';
      return;
    }
    tray.classList.add('visible');
    document.body.classList.add('tray-open');

    const rows = [...state.compare];
    const maxIP = Math.max(0, ...rows.map(r => r._computed?.ip ?? 0));
    const maxCP = Math.max(0, ...rows.map(r => r._computed?.cp ?? 0));
    const maxOP = Math.max(0, ...rows.map(r => r._computed?.op ?? 0));
    const minCost = Math.min(...rows.map(r => r._computed?.cost ?? Infinity));
    const barW = (v, max) => max > 0 ? Math.round(v / max * 100) : 0;

    cards.innerHTML = rows.map((row, i) => {
      const c = row._computed || {};
      const isCheapest = rows.length > 1 && c.cost === minCost;
      const priceVal = p => p != null && Number.isFinite(p) ? fmtPrice(p) : '—';
      const hl = isCheapest ? ' highlight' : '';
      return `
      <div class="cmp-card">
        <button class="cmp-card-remove" title="Remove" data-i="${i}">✕</button>
        <div class="cmp-card-name">${row.dataset.modelId}</div>
        <div class="cmp-card-provider">${row.dataset.providerName} · ${c.plan || '—'}</div>
        <div class="cmp-card-rows">
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Input</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill${hl}" style="width:${barW(c.ip, maxIP)}%"></div></div>
            <span class="cmp-rate-val">${priceVal(c.ip)}</span>
          </div>
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Cached</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill${hl}" style="width:${barW(c.cp, maxCP)}%"></div></div>
            <span class="cmp-rate-val">${priceVal(c.cp)}</span>
          </div>
          <div class="cmp-rate-row">
            <span class="cmp-rate-label">Output</span>
            <div class="cmp-rate-bar-bg"><div class="cmp-rate-bar-fill${hl}" style="width:${barW(c.op, maxOP)}%"></div></div>
            <span class="cmp-rate-val">${priceVal(c.op)}</span>
          </div>
        </div>
        <div class="cmp-card-cost">
          <div>
            <div class="cmp-cost-label">Est. cost</div>
            <div class="cmp-credits">${c.runs != null ? 'Runs: ' + fmtInt(c.runs) : (c.free ? 'Free' : '—')}</div>
          </div>
          <span class="cmp-cost-val${hl}">${c.cost != null ? fmtPrice(c.cost) : '—'}</span>
        </div>
      </div>`;
    }).join('');

    cards.querySelectorAll('.cmp-card-remove').forEach(btn => {
      btn.addEventListener('click', () => toggleCompare(rows[+btn.dataset.i]));
    });
  }

  // ── Off-peak auto-detect ─────────────────────────────────────
  // z.ai off-peak: Mon–Fri 07:00–11:00 CET (their 14:00–18:00 UTC+8).
  // ponytail: Europe/Paris locale string covers CET/CEST; keep the fixed
  // 07:00–11:00 window as published, upgrade to per-season offsets if it matters.
  function autoOffPeak() {
    const toggle = document.getElementById('off-peak-toggle');
    if (!toggle) return;
    const parts = new Date().toLocaleString('en-US',
      { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', hourCycle: 'h23' }
    ).split(/[\s,]+/).filter(Boolean);
    const day = (parts[0] || '').toLowerCase();
    const hour = parseInt(parts[1], 10);
    const weekday = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].indexOf(day);
    if (weekday >= 0 && weekday <= 4 && hour >= 7 && hour < 11) toggle.checked = true;
  }

  // ── Event wiring ─────────────────────────────────────────────
  ['budget-amount', 'input-pct', 'cached-pct', 'output-pct', 'tokens-per-run'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => {
      if (id.endsWith('-pct')) {
        // Manual edits override the active preset
        document.querySelectorAll('.profile-btn').forEach(b => b.classList.remove('active'));
      }
      recompute();
    });
  });
  document.querySelectorAll('input[name="tier"]').forEach(r => r.addEventListener('change', recompute));
  const offPeakToggle = document.getElementById('off-peak-toggle');
  if (offPeakToggle) offPeakToggle.addEventListener('change', recompute);

  // Preset buttons
  document.querySelectorAll('.profile-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = PRESETS[btn.dataset.profile];
      if (!p) return;
      document.getElementById('input-pct').value = p.input;
      document.getElementById('cached-pct').value = p.cached;
      document.getElementById('output-pct').value = p.output;
      document.querySelectorAll('.profile-btn').forEach(b => b.classList.toggle('active', b.dataset.profile === btn.dataset.profile));
      recompute();
    });
  });

  // Show-all toggle
  document.getElementById('show-all-models').addEventListener('change', e => {
    state.showAll = e.target.checked;
    updateShowAllLabel();
    applyFilters();
    updateBars();
    applySort();
  });

  // Search (real-time, static table → no debounce)
  document.getElementById('model-search').addEventListener('input', e => {
    state.search = e.target.value;
    applyFilters();
    updateBars();
    applySort();
  });

  // Provider chips: click toggles that provider's rows
  document.querySelectorAll('#provider-chips .filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.provider;
      if (state.hiddenProviders.has(id)) state.hiddenProviders.delete(id);
      else state.hiddenProviders.add(id);
      btn.classList.toggle('active', !state.hiddenProviders.has(id));
      applyFilters();
      updateBars();
      applySort();
    });
  });

  // Column headers: first click sorts ascending, second reverses
  document.querySelectorAll('#provider-table thead th[data-col]').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.col;
      if (state.sortCol === col) {
        state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        state.sortCol = col;
        state.sortDir = 'asc';
      }
      updateSortIndicators();
      applySort();
    });
  });

  // Compare buttons on rows
  document.querySelectorAll('#provider-table tbody tr').forEach(row => {
    const btn = row.querySelector('.cmp-btn');
    if (btn) btn.addEventListener('click', () => toggleCompare(row));
  });

  // ── Initial render ───────────────────────────────────────────
  autoOffPeak();
  updateSortIndicators();
  updateShowAllLabel();
  applyFilters();
  recompute();
</script>
