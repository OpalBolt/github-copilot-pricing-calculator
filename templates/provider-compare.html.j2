{% import 'macros.html.j2' as m %}
{% set subs = providers | selectattr('pricing_type', 'equalto', 'subscription') | list %}
{% set tier_names = [] %}
{% for p in subs %}
  {% for t in p.tiers %}
    {% if t.name not in tier_names %}{% set _ = tier_names.append(t.name) %}{% endif %}
  {% endfor %}
{% endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Provider price comparison</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,wght@1,500&display=swap" rel="stylesheet" />
  {% include 'styles.css.j2' %}
</head>
<body>

<!-- ── Header ──────────────────────────────────────────────── -->
<header class="page-header">
  <p class="eyebrow">Providers · Price comparison</p>
  <h1>Provider price comparison</h1>
  <p>Compare monthly API costs against fixed subscription plans at any token volume. Dial in your token mix and see which option costs less.</p>
  <p class="meta"><a href="index.html">← All tools</a> · All prices are per 1 million tokens · Baked from providers.json at generate time</p>
</header>

<!-- ── Main ────────────────────────────────────────────────── -->
<main>

  <!-- Controls -->
  <div class="controls provider-controls">
    <h2>Configure your estimate</h2>
    <div class="profile-presets">
      <span class="profile-label">Quick presets:</span>
      <div class="profile-buttons">
        <button class="profile-btn" data-profile="superuser">Superuser/Developer</button>
        <button class="profile-btn" data-profile="regular">Regular User</button>
      </div>
    </div>
    <div class="controls-grid">
      {{ m.input_group('monthly-tokens', 'Monthly tokens (millions)', 50, 0.001, None, 1) }}
      {{ m.input_group('input-pct', 'Input %', 30, 0, 100, 0.1) }}
      {{ m.input_group('cached-pct', 'Cached input %', 50, 0, 100, 0.1) }}
      {{ m.input_group('output-pct', 'Output %', 20, 0, 100, 0.1) }}
    </div>
    <div id="pct-warning" style="display: none; margin-top: 12px; padding: 8px 12px; background: #FEF9C3; border: 1px solid #EAB308; border-radius: 4px; font-size: 13px; color: #854D0E;">
      ⚠️ Input, Cached, and Output percentages must sum to 100%
    </div>
    {% if subs %}
    <div class="column-toggle-chips">
      <span class="filter-label">Subscription tier</span>
      {% for t in tier_names %}
      <label class="column-toggle-chip" for="tier-{{ t | lower }}">
        <input type="radio" name="tier" id="tier-{{ t | lower }}" value="{{ t }}"{% if loop.first %} checked{% endif %} />
        <span>{{ t }}</span>
      </label>
      {% endfor %}
    </div>
    <label class="off-peak-toggle" for="off-peak-toggle">
      <input type="checkbox" id="off-peak-toggle" />
      <span>Off-peak pricing <span class="dim">(Mon–Fri 07:00–11:00 CET)</span></span>
    </label>
    {% endif %}
    <div class="column-toggle-chips">
      <span class="filter-label">Models</span>
      <label class="column-toggle-chip" for="show-all-models">
        <input type="checkbox" id="show-all-models" />
        <span id="show-all-label">Show all models</span>
      </label>
    </div>
    <div class="column-toggle-chips">
      <span class="filter-label">Providers</span>
      <div class="filter-chips" id="provider-chips">
        {% for p in providers %}
        <button type="button" class="filter-chip active" data-provider="{{ p.id }}">{{ p.name }}</button>
        {% endfor %}
      </div>
    </div>
    <div class="search-wrap">
      <span class="filter-label">Search</span>
      <input type="search" id="model-search" placeholder="Filter by model or provider…" />
    </div>
    <div style="margin-top: 16px; display: flex; align-items: center; gap: 10px;">
      <label for="budget-ref" style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate-7); white-space: nowrap;">Budget reference ($)</label>
      <input type="number" id="budget-ref" value="10" min="0" step="1" style="font-family: 'Source Sans 3', sans-serif; font-size: 13px; font-weight: 500; color: var(--nordic-black); background: var(--canvas); border: 1px solid var(--slate-3); border-radius: 2px; padding: 6px 10px; width: 120px; outline: none;" />
    </div>
  </div>

  <!-- Table -->
  <div class="table-wrapper">
    <table id="provider-table">
      <thead>
        <tr>
          <th style="width:36px;padding:10px 8px"></th>
          <th class="sortable" data-col="provider">Provider <span class="sort-icon">↕</span></th>
          <th class="sortable" data-col="plan">Plan <span class="sort-icon">↕</span></th>
          <th class="sortable" data-col="model">Model <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="input">Input $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="cached">Cached $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="output">Output $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="cost">Monthly cost <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="runs">Runs <span class="sort-icon">↕</span></th>
          <th class="sortable bar-cell" data-col="relative">Relative cost <span class="sort-icon">↕</span></th>
        </tr>
      </thead>
      <tbody>
        {% for p in providers %}
          {% set prov_loop = loop %}
          {% if p.pricing_type == 'paygo' %}
            {% for model in p.models %}
            <tr data-provider-id="{{ p.id }}" data-pricing-type="paygo" data-model-id="{{ model.id }}"
                data-input-price="{{ model.input }}" data-cached-price="{{ model.input_cache }}" data-output-price="{{ model.output }}"
                data-default-visible="{{ model.default_visible | default(true) | lower }}" data-provider-name="{{ p.name }}">
              <td><button type="button" class="cmp-btn" title="Add to comparison">+</button></td>
              <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
              <td>Paygo</td>
              <td>{{ model.id }}</td>
              <td class="num" data-sort="{{ model.input }}">${{ '%.4g'|format(model.input) }}</td>
              <td class="num" data-sort="{{ model.input_cache }}">${{ '%.4g'|format(model.input_cache) }}</td>
              <td class="num" data-sort="{{ model.output }}">${{ '%.4g'|format(model.output) }}</td>
              <td class="num monthly-cost">—</td>
              <td class="num runs">—</td>
              <td class="bar-cell rel-cost">—</td>
            </tr>
            {% endfor %}
          {% else %}
            {% for model in p.models %}
            <tr class="sub-row" data-provider-id="{{ p.id }}" data-pricing-type="subscription" data-model-id="{{ model.id }}"
                data-mult-input="{{ model.mult_input }}" data-mult-cached="{{ model.mult_cached }}" data-mult-output="{{ model.mult_output }}"
                data-default-visible="{{ model.default_visible | default(true) | lower }}" data-provider-name="{{ p.name }}">
              <td><button type="button" class="cmp-btn" title="Add to comparison">+</button></td>
              <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
              <td>{{ tier_names[0] if tier_names else '—' }}</td>
              <td>{{ model.id }}</td>
              <td class="num sub-price">—</td>
              <td class="num sub-price">—</td>
              <td class="num sub-price">—</td>
              <td class="num monthly-cost">—</td>
              <td class="num runs">—</td>
              <td class="bar-cell rel-cost">—</td>
            </tr>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  <p class="page-note">
    Monthly cost = total tokens × rate for each model at your mix. Subscription rows show the fixed plan price.
    Effective $/1M for subscriptions = plan price ÷ total monthly tokens. Relative cost = monthly cost ÷ the most
    expensive model currently visible. Hover a subscription row for credit details.
  </p>
</main>

<footer class="page-footer">
  <span>Provider price comparison · Data from providers.json</span>
  <a href="index.html">← All tools</a>
</footer>

<!-- ── Compare tray ────────────────────────────────────────── -->
<div id="compare-tray" role="region" aria-label="Model comparison">
  <div class="tray-header">
    <span class="tray-title">Comparing <span id="tray-count">0</span> models</span>
    <div class="tray-actions">
      <button class="tray-clear" onclick="clearCompare()">Clear all</button>
    </div>
  </div>
  <div class="tray-cards" id="tray-cards"></div>
</div>

{% include 'provider-compare.app.js.j2' %}

</body>
</html>
