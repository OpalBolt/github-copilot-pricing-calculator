{% import 'macros.html.j2' as m %}
{% set subs = providers | selectattr('pricing_type', 'equalto', 'subscription') | list %}
{% set tier_names = [] %}
{% for p in subs %}
  {% for t in p.tiers %}
    {% if t.name not in tier_names %}{% set _ = tier_names.append(t.name) %}{% endif %}
  {% endfor %}
{% endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Provider price comparison</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,wght@1,500&display=swap" rel="stylesheet" />
  {% include 'styles.css.j2' %}
</head>
<body>

<!-- ── Header ──────────────────────────────────────────────── -->
<header class="page-header">
  <p class="eyebrow">Providers · Price comparison</p>
  <h1>Provider price comparison</h1>
  <p>What does a budget buy you on each provider? Pay-per-token and subscription plans sit side by side, normalized to effective tokens per dollar.</p>
  <p class="meta"><a href="index.html">← All tools</a> · All prices are per 1 million tokens · Baked from providers.json at generate time</p>
</header>

<!-- ── Main ────────────────────────────────────────────────── -->
<main>

  <!-- Controls (budget + token mix live; tier/off-peak wired in slice 04) -->
  <div class="controls provider-controls">
    <h2>Configure your estimate</h2>
    <div class="controls-grid">
      {{ m.input_group('budget-amount', 'Budget ($)', 10, 0, None, 0.01) }}
      {{ m.input_group('input-pct', 'Input %', 30, 0, 100, 0.1) }}
      {{ m.input_group('cached-pct', 'Cached input %', 50, 0, 100, 0.1) }}
      {{ m.input_group('output-pct', 'Output %', 20, 0, 100, 0.1) }}
    </div>
    <div id="pct-warning" style="display: none; margin-top: 12px; padding: 8px 12px; background: #FEF9C3; border: 1px solid #EAB308; border-radius: 4px; font-size: 13px; color: #854D0E;">
      ⚠️ Input, Cached, and Output percentages must sum to 100%
    </div>
    {% if subs %}
    <div class="column-toggle-chips">
      <span class="filter-label">Subscription tier</span>
      {% for t in tier_names %}
      <label class="column-toggle-chip" for="tier-{{ t | lower }}">
        <input type="radio" name="tier" id="tier-{{ t | lower }}" value="{{ t }}"{% if loop.first %} checked{% endif %} />
        <span>{{ t }}</span>
      </label>
      {% endfor %}
    </div>
    <label class="off-peak-toggle" for="off-peak-toggle">
      <input type="checkbox" id="off-peak-toggle" />
      <span>Off-peak pricing <span class="dim">({{ subs[0].get('off_peak_label', '') }})</span></span>
    </label>
    {% endif %}
    <div class="column-toggle-chips">
      <span class="filter-label">Models</span>
      <label class="column-toggle-chip" for="show-all-models">
        <input type="checkbox" id="show-all-models" />
        <span id="show-all-label">Show all models</span>
      </label>
    </div>
    <div class="column-toggle-chips">
      <span class="filter-label">Providers</span>
      <div class="filter-chips" id="provider-chips">
        {% for p in providers %}
        <button type="button" class="filter-chip active" data-provider="{{ p.id }}">{{ p.name }}</button>
        {% endfor %}
      </div>
    </div>
    <div class="search-wrap">
      <span class="filter-label">Search</span>
      <input type="search" id="model-search" placeholder="Filter by model or provider…" />
    </div>
  </div>

  <!-- Table -->
  <div class="table-wrapper">
    <table id="provider-table">
      <thead>
        <tr>
          <th class="sortable" data-col="provider">Provider <span class="sort-icon">↕</span></th>
          <th class="sortable" data-col="plan">Plan <span class="sort-icon">↕</span></th>
          <th class="sortable" data-col="model">Model <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="input">Input $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="cached">Cached $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="output">Output $/1M <span class="sort-icon">↕</span></th>
          <th class="sortable num" data-col="effective">Effective tokens/$ <span class="sort-icon">↕</span></th>
        </tr>
      </thead>
      <tbody>
        {% for p in providers %}
          {% set prov_loop = loop %}
          {% if p.pricing_type == 'paygo' %}
            {% for model in p.models %}
            <tr data-provider-id="{{ p.id }}" data-pricing-type="paygo" data-model-id="{{ model.id }}" data-tier=""
                data-input-price="{{ model.input }}" data-cached-price="{{ model.input_cache }}" data-output-price="{{ model.output }}"
                data-default-visible="{{ model.default_visible | default(true) | lower }}" data-provider-name="{{ p.name }}">
              <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
              <td>Paygo</td>
              <td>{{ model.id }}</td>
              <td class="num" data-sort="{{ model.input }}">${{ '%.4g'|format(model.input) }}</td>
              <td class="num" data-sort="{{ model.input_cache }}">${{ '%.4g'|format(model.input_cache) }}</td>
              <td class="num" data-sort="{{ model.output }}">${{ '%.4g'|format(model.output) }}</td>
              <td class="num effective-tokens">—</td>
            </tr>
            {% endfor %}
          {% else %}
            {% for tier in p.tiers %}
              {% for model in p.models %}
              <tr data-provider-id="{{ p.id }}" data-pricing-type="subscription" data-model-id="{{ model.id }}" data-tier="{{ tier.name }}"
                  data-mult-input="{{ model.mult_input }}" data-mult-cached="{{ model.mult_cached }}" data-mult-output="{{ model.mult_output }}"
                  data-default-visible="{{ model.default_visible | default(true) | lower }}" data-provider-name="{{ p.name }}">
                <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
                <td>{{ tier.name }}</td>
                <td>{{ model.id }}</td>
                <td class="num sub-price">—</td>
                <td class="num sub-price">—</td>
                <td class="num sub-price">—</td>
                <td class="num effective-tokens">—</td>
              </tr>
              {% endfor %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  <p class="page-note">
    Prices are per 1M tokens as published. Subscription plans bill in credits — their $/1M is derived from the credit math at your selected tier and token mix.
  </p>
</main>

<footer class="page-footer">
  <span>Provider price comparison · Data from providers.json</span>
  <a href="index.html">← All tools</a>
</footer>

{% include 'provider-compare.app.js.j2' %}

</body>
</html>
