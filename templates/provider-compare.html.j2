{% import 'macros.html.j2' as m %}
{% set subs = providers | selectattr('pricing_type', 'equalto', 'subscription') | list %}
{% set tier_names = [] %}
{% for p in subs %}
  {% for t in p.tiers %}
    {% if t.name not in tier_names %}{% set _ = tier_names.append(t.name) %}{% endif %}
  {% endfor %}
{% endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Provider price comparison</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,wght@1,500&display=swap" rel="stylesheet" />
  {% include 'styles.css.j2' %}
</head>
<body>

<!-- ── Header ──────────────────────────────────────────────── -->
<header class="page-header">
  <p class="eyebrow">Providers · Price comparison</p>
  <h1>Provider price comparison</h1>
  <p>What does a budget buy you on each provider? Pay-per-token and subscription plans sit side by side, normalized to effective tokens per dollar.</p>
  <p class="meta"><a href="index.html">← All tools</a> · All prices are per 1 million tokens · Baked from providers.json at generate time</p>
</header>

<!-- ── Main ────────────────────────────────────────────────── -->
<main>

  <!-- Controls (static; wired up in slices 03–05) -->
  <div class="controls provider-controls">
    <h2>Configure your estimate</h2>
    <div class="controls-grid">
      {{ m.input_group('budget-amount', 'Budget ($)', 10, 0, None, 0.01) }}
      {{ m.input_group('input-pct', 'Input %', 30, 0, 100, 0.1) }}
      {{ m.input_group('cached-pct', 'Cached input %', 50, 0, 100, 0.1) }}
      {{ m.input_group('output-pct', 'Output %', 20, 0, 100, 0.1) }}
    </div>
    {% if subs %}
    <div class="column-toggle-chips">
      <span class="filter-label">Subscription tier</span>
      {% for t in tier_names %}
      <label class="column-toggle-chip" for="tier-{{ t | lower }}">
        <input type="radio" name="tier" id="tier-{{ t | lower }}" value="{{ t }}"{% if loop.first %} checked{% endif %} />
        <span>{{ t }}</span>
      </label>
      {% endfor %}
    </div>
    <label class="off-peak-toggle" for="off-peak-toggle">
      <input type="checkbox" id="off-peak-toggle" />
      <span>Off-peak pricing <span class="dim">({{ subs[0].get('off_peak_label', '') }})</span></span>
    </label>
    {% endif %}
    <div class="column-toggle-chips">
      <span class="filter-label">Models</span>
      <label class="column-toggle-chip" for="show-all-models">
        <input type="checkbox" id="show-all-models" />
        <span>Show all models</span>
      </label>
    </div>
  </div>

  <!-- Table -->
  <div class="table-wrapper">
    <table id="provider-table">
      <thead>
        <tr>
          <th>Provider</th>
          <th>Plan</th>
          <th>Model</th>
          <th class="num">Input $/1M</th>
          <th class="num">Cached $/1M</th>
          <th class="num">Output $/1M</th>
          <th class="num">Effective tokens/$</th>
        </tr>
      </thead>
      <tbody>
        {% for p in providers %}
          {% set prov_loop = loop %}
          {% if p.pricing_type == 'paygo' %}
            {% for model in p.models %}
            <tr>
              <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
              <td>Paygo</td>
              <td>{{ model.id }}</td>
              <td class="num">${{ '%.4g'|format(model.input) }}</td>
              <td class="num">${{ '%.4g'|format(model.input_cache) }}</td>
              <td class="num">${{ '%.4g'|format(model.output) }}</td>
              <td class="num">—</td>
            </tr>
            {% endfor %}
          {% else %}
            {% for tier in p.tiers %}
              {% for model in p.models %}
              <tr>
                <td><span class="provider-badge pb-{{ prov_loop.index0 % 6 }}">{{ p.name }}</span></td>
                <td>{{ tier.name }}</td>
                <td>{{ model.id }}</td>
                <td class="num">—</td>
                <td class="num">—</td>
                <td class="num">—</td>
                <td class="num">—</td>
              </tr>
              {% endfor %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  <p class="page-note">
    Prices are per 1M tokens as published. Subscription plans bill in credits — their $/1M and the Effective tokens/$ column fill in once the budget, token mix, tier, and off-peak math are wired up.
  </p>
</main>

<footer class="page-footer">
  <span>Provider price comparison · Data from providers.json</span>
  <a href="index.html">← All tools</a>
</footer>

</body>
</html>
