<script>
  const ALL_MODELS = {{ models_json }};
  const ROUTERS = {{ routers_json }};
  const EXCHANGE_RATE = {{ exchange_rate_json }};

  const PROFILES = {
    superuser: { input: 0.49, cached: 98.62, output: 0.89 },
    regular: { input: 5.45, cached: 86.36, output: 8.18 },
  };
  const state = {
    mode: 'default',
    sortCol: 'cost',
    sortDir: 'asc',
    search: '',
    creator: '',
    minimumRuns: 0,
    hideFree: false,
    routers: new Set(),
    filters: { reasoning: false, tools: false, vision: false, audio: false },
    showInput: true,
    showCached: true,
    showOutput: true,
    compareIds: new Set(),
    activeProfile: null,
  };
  const MAX_COMPARE = 5;
  const fmt = n => n.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
  const fmtMoney = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtRuns = n => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
  const rate = n => n === 0 ? 'Free' : `€${fmt(n)}`;
  const activeRates = (model, cfg = null) => {
    const base = model[state.mode];
    if (!base || state.mode !== 'default' || !cfg || !model.pricingTiers?.length) return base;
    const contextTokens = cfg.inputTokens + cfg.cachedTokens;
    return model.pricingTiers.reduce(
      (rates, tier) => contextTokens > tier.contextAbove ? tier : rates,
      base,
    );
  };
  const isFree = prices => prices.input === 0 && prices.cached === 0 && prices.output === 0;
  const encoded = key => encodeURIComponent(key);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, character => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  })[character]);

  function getConfig() {
    const total = parseFloat(document.getElementById('total-tokens').value) || 1_000_000;
    let ip = parseFloat(document.getElementById('input-pct').value) || 0;
    let cp = parseFloat(document.getElementById('cached-pct').value) || 0;
    let op = parseFloat(document.getElementById('output-pct').value) || 0;
    const budget = Math.max(0, parseFloat(document.getElementById('budget-amount').value) || 0);
    const sum = ip + cp + op;
    document.getElementById('pct-warning').style.display = Math.abs(sum - 100) > 0.1 ? 'block' : 'none';
    if (sum > 0) { ip = ip / sum * 100; cp = cp / sum * 100; op = op / sum * 100; }
    return {
      total, ip, cp, op, budget,
      inputTokens: total * ip / 100,
      cachedTokens: total * cp / 100,
      outputTokens: total * op / 100,
    };
  }

  function estimateCost(rates, cfg) {
    return (cfg.inputTokens / 1_000_000) * rates.input
      + (cfg.cachedTokens / 1_000_000) * rates.cached
      + (cfg.outputTokens / 1_000_000) * rates.output;
  }

  function capabilities(model, compact = true) {
    const labels = { reasoning: 'R', tools: 'T', vision: 'V', audio: 'A' };
    return Object.entries(model.capabilities || {})
      .filter(([, enabled]) => enabled)
      .map(([name]) => `<span class="cap cap-${name}" title="${name}">${compact ? labels[name] : name}</span>`).join('');
  }

  function warnings(model, rates) {
    let result = '';
    if (model.direct) result += '<span class="direct-chip" title="Direct provider API price; this offer is not routed">Direct API</span>';
    if (rates.cachedFallback && !isFree(rates)) result += '<span class="warning-chip" title="No cached-input rate is published. The estimate uses the normal input rate.">⚠</span>';
    if (model.quantization) result += `<span class="warning-chip" title="A provider matching this price uses heavy quantization">${model.quantization}</span>`;
    if (state.mode === 'default' && model.eu) result += '<span class="router-chip" title="EU price available">EU</span>';
    if (state.mode === 'eu') result += '<span class="router-chip" title="Using EU routing">EU</span>';
    return result;
  }

  function passesFilters(model, cfg) {
    const prices = activeRates(model, cfg);
    if (!prices) return false;
    if (state.routers.size && !state.routers.has(model.router)) return false;
    if (state.creator && !(model.owner || '').toLowerCase().includes(state.creator)) return false;
    if (state.hideFree && isFree(prices)) return false;
    if (state.minimumRuns > 0) {
      const cost = estimateCost(prices, cfg);
      const runs = cost > 0 ? cfg.budget / cost : Infinity;
      if (runs < state.minimumRuns) return false;
    }
    if (state.search) {
      const haystack = [
        model.name, model.modelId, model.owner, model.routerName,
        ...(model.providers || []), ...(model.euProviders || []),
      ].join(' ').toLowerCase();
      if (!haystack.includes(state.search.toLowerCase())) return false;
    }
    return Object.entries(state.filters)
      .every(([name, enabled]) => !enabled || model.capabilities?.[name]);
  }

  function sortRows(rows) {
    const direction = state.sortDir === 'asc' ? 1 : -1;
    rows.sort((a, b) => {
      const av = a[state.sortCol], bv = b[state.sortCol];
      if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * direction;
      return String(av ?? '').localeCompare(String(bv ?? '')) * direction;
    });
  }

  function barHtml(cost, maxCost) {
    if (cost === 0) return '<span class="dim">free</span>';
    return `<div class="credit-bar-wrap"><div class="credit-bar-bg"><div class="credit-bar-fill" style="width:${Math.round(cost / maxCost * 100)}%"></div></div></div>`;
  }

  function summaryChips(cfg) {
    document.getElementById('summary-chips').innerHTML = `
      <span class="chip">Total tokens: <strong>${cfg.total.toLocaleString()}</strong></span>
      <span class="chip">Input: <strong>${Math.round(cfg.ip)}%</strong></span>
      <span class="chip">Cached: <strong>${Math.round(cfg.cp)}%</strong></span>
      <span class="chip">Output: <strong>${Math.round(cfg.op)}%</strong></span>
      <span class="chip">Budget: <strong>€${fmtMoney(cfg.budget)}</strong></span>`;
  }

  function render() {
    const cfg = getConfig();
    const rows = ALL_MODELS.filter(model => passesFilters(model, cfg)).map(model => {
      const prices = activeRates(model, cfg);
      const cost = estimateCost(prices, cfg);
      return { ...model, ...prices, cost, runs: cost > 0 ? cfg.budget / cost : null };
    });
    sortRows(rows);
    const maxCost = rows.reduce((maximum, model) => Math.max(maximum, model.cost), 0) || 1;
    document.getElementById('table-body').innerHTML = rows.map(model => {
      const selected = state.compareIds.has(model.key);
      return `<tr class="model-row router-${model.router}${selected ? ' in-compare' : ''}" data-key="${encoded(model.key)}">
        <td class="cmp-cell"><button class="cmp-btn${selected ? ' active' : ''}" onclick="toggleCompare(decodeURIComponent('${encoded(model.key)}'))">${selected ? '−' : '+'}</button></td>
        <td><span class="router-chip">${esc(model.routerName)}</span></td>
        <td class="model-id" title="${esc(model.name)}">${esc(model.name)}</td>
        <td class="owner" title="${esc(model.owner || '')}">${esc(model.owner || '—')}</td>
        <td class="caps">${capabilities(model)}${warnings(model, model)}</td>
        <td class="num col-input">${rate(model.input)}</td>
        <td class="num col-cached">${rate(model.cached)}${model.cachedFallback && !isFree(model) ? ' ⚠' : ''}</td>
        <td class="num col-output">${rate(model.output)}</td>
        <td class="num cost-cell">${model.cost > 0 ? `€${fmt(model.cost)}` : 'Free'}</td>
        <td class="num runs-cell">${model.runs == null ? '—' : fmtRuns(model.runs)}</td>
        <td class="bar-cell">${barHtml(model.cost, maxCost)}</td>
      </tr>`;
    }).join('');
    document.getElementById('no-results').style.display = rows.length ? 'none' : 'block';
    document.getElementById('row-count').innerHTML = `Showing <strong>${rows.length}</strong> of <strong>${ALL_MODELS.length}</strong> price offers`;
    document.querySelectorAll('thead th[data-col]').forEach(th => {
      const icon = th.querySelector('.sort-icon');
      icon.textContent = th.dataset.col === state.sortCol ? (state.sortDir === 'asc' ? '↑' : '↓') : '↕';
    });
    summaryChips(cfg);
    applyColumnVisibility();
    renderCompareTray(cfg);
  }

  function detailHtml(model) {
    const prices = activeRates(model, getConfig());
    const providers = (state.mode === 'eu' ? model.euProviders : model.providers) || [];
    const router = ROUTERS.find(item => item.id === model.router);
    const free = isFree(prices);
    const native = prices.native && !free
      ? `<div class="detail-item"><strong>Native USD per 1M</strong>$${fmt(prices.native.input)} input · ${prices.cachedFallback ? 'cache not published' : '$' + fmt(prices.native.cached) + ' cached'} · $${fmt(prices.native.output)} output</div>`
      : '';
    const cache = free
      ? '<p class="detail-note"><strong>Free offer:</strong> All input and output token rates are zero. Cache-price fallback does not change the estimate, so no cache warning is needed.</p>'
      : prices.cachedFallback
      ? `<p class="detail-note"><strong>⚠ Cache rate not published:</strong> The router catalog has no cached-input price for this offer. For calculations, cached tokens use the normal input rate (${rate(prices.input)} per 1M). This is an estimate, not a published cache price, and it does not mean the model supports prompt caching.</p>`
      : '';
    const euFree = model.eu ? isFree(model.eu) : false;
    const euDetails = model.eu
      ? `<div class="detail-item"><strong>EU Router Price</strong>${rate(model.eu.input)} input · ${rate(model.eu.cached)} cached${model.eu.cachedFallback && !euFree ? ' (estimate)' : ''} · ${rate(model.eu.output)} output</div>
         <div class="detail-item"><strong>EU providers in bulk catalog</strong>${model.euProviders?.length ? model.euProviders.map(esc).join(', ') : 'Not supplied'}</div>`
      : '<div class="detail-item"><strong>EU routing</strong>Not listed for this router model offer</div>';
    const euClaim = model.eu && router
      ? `<p class="detail-note"><strong>EU routing meaning:</strong> ${esc(router.euClaim)}</p>`
      : '';
    const plan = model.eu && model.euPlan
      ? `<p class="detail-note"><strong>Plan restriction:</strong> ${esc(model.routerName)} EU routing requires ${esc(model.euPlan)}.</p>`
      : '';
    const tiers = model.pricingTiers?.length
      ? `<p class="detail-note"><strong>Long-context pricing:</strong> Higher rates are selected automatically when input plus cached tokens exceed ${model.pricingTiers.map(tier => tier.contextAbove.toLocaleString()).join(' or ')} tokens per calculation.</p>`
      : '';
    return `<div class="detail-panel">
      <div class="detail-title">${esc(model.name)}</div>
      ${model.description ? `<p class="detail-description">${esc(model.description)}</p>` : ''}
      <div class="detail-grid">
        <div class="detail-item"><strong>Model ID</strong>${esc(model.modelId)}</div>
        <div class="detail-item"><strong>Model creator</strong>${esc(model.owner || 'Not supplied')}</div>
        <div class="detail-item"><strong>Context</strong>${model.contextSize ? model.contextSize.toLocaleString() + ' tokens' : 'Not supplied'}</div>
        <div class="detail-item"><strong>Release date</strong>${esc(model.releaseDate || 'Not supplied')}</div>
        <div class="detail-item"><strong>Access type</strong>${model.direct ? 'Direct API (not routed)' : state.mode === 'eu' ? 'EU routing' : 'Unrestricted inference'}</div>
        <div class="detail-item"><strong>EUR per 1M</strong>€${fmt(prices.input)} input · €${fmt(prices.cached)} cached${prices.cachedFallback && !free ? ' (estimate)' : ''} · €${fmt(prices.output)} output</div>
        <div class="detail-item"><strong>Providers in bulk catalog</strong>${providers.length ? providers.map(esc).join(', ') : 'Not supplied'}</div>
        <div class="detail-item"><strong>Capabilities</strong>${capabilities(model, false) || 'None explicitly published'}</div>
        ${euDetails}
        ${native}
      </div>
      <p class="detail-note"><strong>Price provenance:</strong> ${esc(model.priceNote)}</p>
      ${prices.native && !free ? `<p class="detail-note"><strong>ECB conversion:</strong> 1 EUR = ${EXCHANGE_RATE.usdPerEur} USD on ${EXCHANGE_RATE.observationDate}.</p>` : ''}
      ${euClaim}${cache}${plan}${tiers}
      <p class="detail-note dim">Listed at the router's recorded fetch time. This does not promise live capacity or account access.</p>
    </div>`;
  }

  function onRowClick(event) {
    if (event.target.closest('.cmp-btn')) return;
    const row = event.target.closest('tr.model-row');
    if (!row) return;
    if (row.nextElementSibling?.classList.contains('drilldown-row')) {
      row.nextElementSibling.remove();
      return;
    }
    const model = ALL_MODELS.find(item => item.key === decodeURIComponent(row.dataset.key));
    const detail = document.createElement('tr');
    detail.className = 'drilldown-row';
    detail.innerHTML = `<td colspan="11">${detailHtml(model)}</td>`;
    row.after(detail);
  }

  function renderCompareTray(cfg) {
    const tray = document.getElementById('compare-tray');
    const cards = document.getElementById('tray-cards');
    const selected = [...state.compareIds]
      .map(key => ALL_MODELS.find(model => model.key === key))
      .filter(Boolean);
    document.getElementById('tray-count').textContent = selected.length;
    if (!selected.length) {
      tray.classList.remove('visible');
      document.body.classList.remove('tray-open');
      return;
    }
    tray.classList.add('visible');
    document.body.classList.add('tray-open');
    cards.innerHTML = selected.map(model => {
      const prices = activeRates(model, cfg);
      const remove = `<button class="cmp-card-remove" onclick="toggleCompare(decodeURIComponent('${encoded(model.key)}'))">✕</button>`;
      if (!prices) {
        return `<div class="cmp-card">${remove}<div class="cmp-card-name">${esc(model.name)}</div><div class="cmp-card-provider">${esc(model.routerName)}</div><p class="unavailable">Unavailable with EU routing</p></div>`;
      }
      const cost = estimateCost(prices, cfg);
      const runs = cost > 0 ? cfg.budget / cost : null;
      return `<div class="cmp-card">
        ${remove}
        <div class="cmp-card-name">${esc(model.name)}</div>
        <div class="cmp-card-provider">${esc(model.routerName)}</div>
        <div class="cmp-card-rows">
          <div class="cmp-rate-row"><span class="cmp-rate-label">Input</span><span class="cmp-rate-val">${rate(prices.input)}</span></div>
          <div class="cmp-rate-row"><span class="cmp-rate-label">Cached${prices.cachedFallback && !isFree(prices) ? ' ⚠' : ''}</span><span class="cmp-rate-val">${rate(prices.cached)}</span></div>
          <div class="cmp-rate-row"><span class="cmp-rate-label">Output</span><span class="cmp-rate-val">${rate(prices.output)}</span></div>
        </div>
        <div class="cmp-card-cost"><div><div class="cmp-cost-label">Est. cost / run</div><div class="cmp-credits">${runs == null ? '—' : fmtRuns(runs)} runs in budget</div></div><span class="cmp-cost-val">${cost > 0 ? `€${fmt(cost)}` : 'Free'}</span></div>
      </div>`;
    }).join('');
  }

  function toggleCompare(key) {
    if (state.compareIds.has(key)) state.compareIds.delete(key);
    else if (state.compareIds.size < MAX_COMPARE) state.compareIds.add(key);
    render();
  }
  function clearCompare() { state.compareIds.clear(); render(); }
  function applyColumnVisibility() {
    const table = document.getElementById('router-table');
    table.classList.toggle('hide-input', !state.showInput);
    table.classList.toggle('hide-cached', !state.showCached);
    table.classList.toggle('hide-output', !state.showOutput);
  }
  function recompute() { render(); }
  function setProfile(key) {
    const profile = PROFILES[key];
    state.activeProfile = key;
    document.getElementById('input-pct').value = profile.input;
    document.getElementById('cached-pct').value = profile.cached;
    document.getElementById('output-pct').value = profile.output;
    document.querySelectorAll('.profile-btn').forEach(button => button.classList.toggle('active', button.dataset.profile === key));
    render();
  }

  document.getElementById('eu-routing-filter').addEventListener('click', event => {
    state.mode = state.mode === 'default' ? 'eu' : 'default';
    event.currentTarget.classList.toggle('active', state.mode === 'eu');
    render();
  });
  document.getElementById('router-filters').addEventListener('click', event => {
    const button = event.target.closest('[data-router]');
    if (!button) return;
    const router = button.dataset.router;
    if (state.routers.has(router)) state.routers.delete(router); else state.routers.add(router);
    button.classList.toggle('active', state.routers.has(router));
    render();
  });
  document.getElementById('capability-filters').addEventListener('click', event => {
    const button = event.target.closest('[data-filter]');
    if (!button) return;
    const filter = button.dataset.filter;
    state.filters[filter] = !state.filters[filter];
    button.classList.toggle('active', state.filters[filter]);
    render();
  });
  document.getElementById('search-input').addEventListener('input', event => { state.search = event.target.value; render(); });
  document.getElementById('creator-filter').addEventListener('input', event => {
    state.creator = event.target.value.trim().toLowerCase();
    render();
  });
  document.getElementById('minimum-runs-filter').addEventListener('change', event => {
    state.minimumRuns = Number(event.target.value) || 0;
    render();
  });
  document.getElementById('hide-free-filter').addEventListener('click', event => {
    state.hideFree = !state.hideFree;
    event.currentTarget.classList.toggle('active', state.hideFree);
    render();
  });
  document.querySelectorAll('thead th.sortable').forEach(th => th.addEventListener('click', () => {
    if (state.sortCol === th.dataset.col) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
    else { state.sortCol = th.dataset.col; state.sortDir = 'asc'; }
    render();
  }));
  [['toggle-input-col', 'showInput'], ['toggle-cached-col', 'showCached'], ['toggle-output-col', 'showOutput']]
    .forEach(([id, key]) => document.getElementById(id).addEventListener('change', event => {
      state[key] = event.target.checked; applyColumnVisibility();
    }));
  document.querySelectorAll('.profile-btn').forEach(button => button.addEventListener('click', () => setProfile(button.dataset.profile)));
  ['total-tokens', 'input-pct', 'cached-pct', 'output-pct', 'budget-amount']
    .forEach(id => document.getElementById(id).addEventListener('input', recompute));
  document.getElementById('table-body').addEventListener('click', onRowClick);
  const creators = new Map();
  ALL_MODELS.map(model => model.owner).filter(Boolean).forEach(creator => {
    const key = creator.toLowerCase();
    if (!creators.has(key)) creators.set(key, creator);
  });
  document.getElementById('creator-options').innerHTML = [...creators.values()]
    .sort((a, b) => a.localeCompare(b))
    .map(creator => `<option value="${esc(creator)}"></option>`).join('');
  render();
</script>
